{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      ".read": "auth != null && root.child('access').child(auth.uid).child('banned').val() != true && (!root.child('access').child(auth.uid).child('kickedUntil').exists() || root.child('access').child(auth.uid).child('kickedUntil').val() <= now)"
    },
    "messages": {
      "$room": {
        ".read": "auth != null && root.child('access').child(auth.uid).child('banned').val() != true && (!root.child('access').child(auth.uid).child('kickedUntil').exists() || root.child('access').child(auth.uid).child('kickedUntil').val() <= now)",
        ".indexOn": ["at"]
      }
    },
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    },
    "access": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('access').child(auth.uid).child('banned').val() != true && (!root.child('access').child(auth.uid).child('kickedUntil').exists() || root.child('access').child(auth.uid).child('kickedUntil').val() <= now) && (root.child('roles').child(auth.uid).val() == 'admin' || root.child('roles').child(auth.uid).val() == 'moderator')"
    },
    "presence": {
      ".read": "auth != null && root.child('access').child(auth.uid).child('banned').val() != true && (!root.child('access').child(auth.uid).child('kickedUntil').exists() || root.child('access').child(auth.uid).child('kickedUntil').val() <= now)",
      "$uid": {
        "$session": {
          ".write": "auth != null && auth.uid == $uid && (!newData.exists() || (auth != null && root.child('access').child(auth.uid).child('banned').val() != true && (!root.child('access').child(auth.uid).child('kickedUntil').exists() || root.child('access').child(auth.uid).child('kickedUntil').val() <= now)))",
          ".validate": "newData.hasChildren(['room','at','typing'])",
          "room": {
            ".validate": "newData.isString() && (newData.val() == 'general' || newData.val() == 'games' || newData.val() == 'movies' || newData.val() == 'books' || newData.val() == 'off-topic')"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 10000"
          },
          "typing": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
