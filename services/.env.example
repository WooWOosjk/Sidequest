# Copy to .env locally, or set in your hosting provider's environment settings.
HOST=127.0.0.1
PORT=8080
# Required when HOST is not loopback. Use HTTPS for a remotely hosted service.
SERVICE_USER=sidequest
SERVICE_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TMDB_TOKEN=
# Optional HTTPS player URLs you have permission to embed. Available substitutions:
# {id} for movies, {id}, {season}, {episode} for TV. Leave empty for TMDB watch links.
MOVIE_PLAYER_TEMPLATE=
TV_PLAYER_TEMPLATE=
